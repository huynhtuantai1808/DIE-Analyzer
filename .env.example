# Copy to .env and replace every example secret before starting.
POSTGRES_DB=dieweb
POSTGRES_USER=dieweb
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@localhost
WEB_PORT=8080
UPLOAD_PATH=./data/uploads
MAX_UPLOAD_MB=250
MAX_SCAN_SECONDS=90
DIE_VERSION=4.1.0
